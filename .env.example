# .env.example - template for the .env file (this file IS in git).
#
#   cp .env.example .env      then replace the placeholders in .env
#
# .env is never pushed (see .gitignore). Fake values only: this is a school
# project, there is no real database and no real API.
# Format: KEY=value   (no space around "=", no quotes needed)

# --- dev ---------------------------------------------------------------
DEV_DATABASE_URL=postgresql://dev_user:<password>@localhost:5432/bookride_dev
DEV_API_KEY=<dev-api-key>

# --- staging -----------------------------------------------------------
STAGING_DATABASE_URL=postgresql://staging_user:<password>@staging-db:5432/bookride_staging
STAGING_API_KEY=<staging-api-key>

# --- prod --------------------------------------------------------------
PROD_DATABASE_URL=postgresql://prod_user:<password>@prod-db:5432/bookride_prod
PROD_API_KEY=<prod-api-key>

# --- Elasticsearch + Kibana (docker-compose.yml, 2.3) --------------------
# Elastic Stack version (Elasticsearch and Kibana use the same one)
STACK_VERSION=8.15.3
# Password of the superuser "elastic" (curl requests and Kibana login), 6 characters or more
ELASTIC_PASSWORD=<password>
# Password of the built-in account "kibana_system" (used by Kibana only), 6 characters or more
KIBANA_PASSWORD=<password>
# Host ports (published on 127.0.0.1). Change them here when a port is busy.
ES_PORT_EXPOSE=9201
KIBANA_PORT_EXPOSE=5602
# Memory of Elasticsearch
ES_JAVA_OPTS=-Xms1g -Xmx1g
